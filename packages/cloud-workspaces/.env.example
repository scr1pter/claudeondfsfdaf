# Variable reference only. Supply real values through the deployment secret store.
# Do not put credentials in the repository, PUBLIC_ variables or browser bundles.

# Dedicated Linux workspace supervisor.
NODE_ENV=production
# Containers must reach the scoped relay through the Docker host gateway.
# Restrict host ingress with the operator's firewall/TLS proxy and network policy.
HOST=0.0.0.0
PORT=4097
VECTOR_WORKSPACES_DATA=/var/lib/vector/cloud-workspaces

# Share the same independently generated >=32-character secret with the account API.
VECTOR_WORKSPACES_SECRET=
# Required immutable image ID or registry image@sha256 digest; never a mutable tag.
VECTOR_WORKSPACES_IMAGE=
VECTOR_WORKSPACES_NETWORK=vector-workspaces
VECTOR_WORKSPACES_RUNTIME=runsc
# Required production driver: it must enforce 10 GiB per workspace in this build.
# Production refuses the default local driver. Validate the driver's quota behavior.
VECTOR_WORKSPACES_VOLUME_DRIVER=
# Driver option name; the runtime supplies its allowance as a byte count.
VECTOR_WORKSPACES_VOLUME_SIZE_OPTION=size
VECTOR_WORKSPACES_RELAY_ORIGIN=http://host.docker.internal:4097

# Fixed OpenAI-compatible model API base, e.g. https://provider.example/v1.
# The primary model key stays only on the supervisor, never in an engine/container.
VECTOR_WORKSPACES_MODEL=
# Optional; omit entirely to use the model ID as its display name.
# VECTOR_WORKSPACES_MODEL_NAME=Pilot model
VECTOR_WORKSPACES_MODEL_ORIGIN=
VECTOR_WORKSPACES_MODEL_KEY=
VECTOR_WORKSPACES_MAX_MODEL_CALLS=50
VECTOR_WORKSPACES_MAX_OUTPUT=4096
VECTOR_WORKSPACES_MAX_RUN_MINUTES=120
VECTOR_WORKSPACES_MAX_ACTIVE=2
# Includes stopped/error workspaces. Must be >= MAX_ACTIVE.
VECTOR_WORKSPACES_MAX_TOTAL=10
# Development/CI fixtures only; leave unset in production.
# VECTOR_WORKSPACES_DEV_UNSAFE=true

# Account API deployment, configured separately from the supervisor.
# Retain ORIGIN/SECRET for account-deletion cleanup even if ENABLED becomes false.
VECTOR_WORKSPACES_ORIGIN=https://workspaces.example.invalid
VECTOR_WORKSPACES_ENABLED=false
# Comma-separated exact account UUIDs; an empty list admits nobody.
VECTOR_WORKSPACES_ACCOUNTS=
# VECTOR_WORKSPACES_SECRET must match the supervisor's secret above.
# Existing gateway requirements remain configured through their normal secret stores:
# SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY (or SUPABASE_ANON_KEY),
# KV_REST_API_URL + KV_REST_API_TOKEN (or the UPSTASH_REDIS_REST_ equivalents),
# VECTOR_ABUSE_SECRET; existing CLI-token and account-deletion settings as applicable.
