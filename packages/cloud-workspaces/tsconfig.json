{
  "extends": "@tsconfig/node22/tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "types": ["bun", "node"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "script/**/*.ts"]
}
