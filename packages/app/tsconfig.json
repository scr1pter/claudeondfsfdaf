{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "composite": true,
    "target": "ESNext",
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "allowJs": true,
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "node_modules/.ts-dist",
    "isolatedModules": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src",
    "package.json",
    "test-browser/vectorscope-owner.test.ts",
    "test-browser/vectorscope-local.test.ts",
    "test-browser/vectorscope-fix.test.ts",
    "test-browser/model-picker-state.test.ts",
    "test-browser/phone-alert-state.test.ts"
  ],
  "exclude": ["dist", "ts-dist"]
}
