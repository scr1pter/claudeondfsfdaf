---
import {
  AppWindow,
  ArrowRight,
  BadgeCheck,
  Blocks,
  Bot,
  ChevronLeft,
  ChevronRight,
  Coins,
  Eye,
  GitBranch,
  GitPullRequest,
  GitFork,
  Laptop,
  Lock,
  Network,
  PanelsTopLeft,
  Plus,
  Radar,
  Rocket,
  ShieldCheck,
  ScanEye,
  Sparkles,
  Split,
  SquareTerminal,
  Terminal,
  Waypoints,
  Workflow,
} from "lucide-react"
import MarketingNav from "./marketing/MarketingNav.astro"
import ShotWindow from "./marketing/shots/ShotWindow.astro"
import { sessionShot } from "./marketing/shots/shots"
import AppShots from "./marketing/AppShots.astro"
import LanderMotion from "./marketing/LanderMotion.astro"
import LanderMaterials from "./marketing/LanderMaterials.astro"
import SiteFooter from "./marketing/SiteFooter.astro"
import { wordmarkCells } from "../lib/wordmark"
import { brainRelease } from "../data/vector-releases"

// The landing page is the whole product tour: the hero and its one interactive
// picture, the self-evolving section, and the card shelf of what Vector does,
// each card linked to the docs page that covers it in full. The hero stays as short as it was: it says what Vector is,
// with one emphasis line that labels the brain from brainRelease. The detail lives in the sections below, Vector Brain
// in the self-evolving section.

// The self-evolving agent of desktop 1.99.110, called coming or new by brainRelease: the brain (rules, memory and lessons
// in one local graph) and documents read into structured knowledge linked to the code, searched on the computer. Its
// numbers come only from the dated knowledge eval in docs/benchmarks (test/landing-copy.test.ts checks them). The hero
// deck and the memory card name the release, so the page stays true for readers still on an earlier one.
const evolvingFacts = [
  {
    title: "A brain for each repository",
    text: "Rules, memory, what the agent learns and the documents you give it, in one local graph. It adds to it as it works, and one click undoes anything it learned.",
  },
  {
    title: "Linked to your code",
    text: "Specs, PDFs and docs are read into requirements, limits and decisions, linked to the code they name, and flagged when the code drifts from them.",
  },
  {
    title: "Only what the task needs",
    text: 'The tokenomics engine sends the few cards a task needs and stops at its budget. "hi" carries no memory at all, so it costs nothing extra.',
  },
]

// The number of one-click plugins, for the plugins card
// (packages/app/src/components/plugins/catalog.tsx — keep the number in step with it).
const pluginCount = 134

// The shelf of things Vector does, each sentence checked against the code that
// ships it and linked to the docs section that describes it in full. Order:
// review, the browser, the agents, where you work with it, what it ships to,
// then how it keeps itself honest.
// Privacy in six claims, each checked against the code and /legal/privacy on 17 October 2026.
// Keep the "coming soon" labels until Codium sales open. The free-model claim must hold for 1.99.108, whose free models
// are all no-training ones, and from 1.99.109, which adds models that may train behind a label and a one-time
// acceptance: Vector itself never trains.
const privacyFacts = [
  {
    title: "Local first",
    text: "Sessions, history and checkpoints are saved on your computer, and desktop dictation is transcribed there too.",
  },
  {
    title: "Straight to your provider",
    text: "With your own key, prompts go straight to that provider under its terms, never through Vector, and a model on your own computer keeps them there.",
  },
  {
    title: "No copy on our servers",
    text: "Vector's servers never keep your prompts or code, except what you choose to send: a share link you publish, public for 30 days at most, or a bug report.",
  },
  {
    title: "Never trained on",
    text: "Vector collects nothing for training, and Vector Velocity, our planned model with 550B+ parameters, won't be trained on customers' code.",
  },
  {
    title: "On Vector's own models",
    text: "Codium, coming soon, routes only to endpoints OpenRouter records as zero data retention. Requests to free models whose providers don't train ask them not to train on your prompts, and free models whose providers may train are labelled May train on your prompts and sent only after you accept that once. Providers of free models may still keep prompts under their own policies.",
  },
  {
    title: "Counts, not content",
    text: "Usage counts are totals like sessions and tokens, never your prompts, code, file names or output. You can switch them off, and crash reports are off by default.",
  },
]

const trustCards = [
  {
    icon: GitPullRequest,
    lead: "Vectorscope reviews your code.",
    text: "On every pull request and in the app: a summary and comments on the exact lines, never an approval.",
    href: "/docs/vectorscope",
    more: "Read about code review",
  },
  {
    icon: ShieldCheck,
    lead: "Security gets its own reader.",
    text: "Touch auth, crypto, SQL, payments or a workflow file and a second, security-only review runs beside the first.",
    href: "/docs/vectorscope#planning",
    more: "Read what the security pass covers",
  },
  {
    icon: Terminal,
    lead: "Reviewed before you push.",
    text: "One command runs the same review on your branch, against its merge base, before anyone else sees it.",
    href: "/docs/vectorscope#before-you-push",
    more: "Read about reviewing before you push",
  },
  {
    icon: AppWindow,
    lead: "A real browser, not screenshots.",
