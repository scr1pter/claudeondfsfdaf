  },
  {
    icon: Blocks,
    lead: `${pluginCount} plugins, one click each.`,
    text: "GitHub, Linear, Sentry, Supabase and Stripe connect from the catalog, and any MCP server you write plugs in beside them.",
    href: "/docs/mcp-and-plugins",
    more: "Read about plugins and MCP",
  },
  {
    icon: Rocket,
    lead: "Ship from your own accounts.",
    text: "Connect Vercel and Supabase and deploy on your own tokens, encrypted on your machine.",
    href: "/docs/cloud-services",
    more: "Read about Vector Cloud",
  },
  {
    icon: Radar,
    lead: "Deploys check themselves.",
