---
// More screens from the desktop app, rebuilt as pages rather than pasted in as
// pictures: the browser beside a session and the Agent Dashboard. The agent
// session itself is the hero's window. Each window is a ShotWindow, laid out at
// the app's own size and scaled to fit.
import ShotWindow from "./shots/ShotWindow.astro"
import { sectionShots } from "./shots/shots"
---

<section id="inside" data-chapter="Inside Vector" class="shots" aria-label="Inside Vector">
  {
    sectionShots.map((shot) => (
      <article id={shot.id} class="shot" aria-labelledby={`${shot.id}-title`}>
        <div class="shot-copy" data-reveal-group>
          <p class="shot-kicker" data-reveal>{shot.kicker}</p>
          <h2 id={`${shot.id}-title`} class="shot-title" data-reveal>
            {shot.title}
          </h2>
          <p class="shot-text" data-reveal>
            {shot.text}
          </p>
        </div>
        <ShotWindow shot={shot} />
      </article>
    ))
  }
</section>

<style>
  .shots {
    --shots-width: min(1440px, calc(100% - 40px));
    position: relative;
    padding: clamp(120px, 11vw, 168px) 0 24px;
  }

  /* Keep the glyph field behind the demo captions readable. */
  .shot-copy::before {
    content: "";
    position: absolute;
    inset: -96px -12%;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(closest-side, rgba(8, 6, 13, 0.86), rgba(8, 6, 13, 0.62) 55%, rgba(8, 6, 13, 0) 100%);
  }

  .shot {
    width: var(--shots-width);
    margin: 0 auto;
    scroll-margin-top: 96px;
  }

  .shot + .shot {
    margin-top: clamp(88px, 9vw, 136px);
  }

  /* The words beside each window: the title on the left, the caption on the
     right, both on the window's edge. */
  .shot-copy {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    column-gap: 48px;
    align-items: end;
    margin-bottom: 28px;
    padding-inline: 8px;
  }

  .shot-kicker {
    grid-column: 1 / -1;
    margin: 0 0 14px;
    color: #aa8cff;
    font-size: 12px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .shot-title {
    margin: 0;
    color: #f5f5f7;
    font-size: 36px;
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .shot-text {
    max-width: 560px;
    margin: 0;
    color: #a1a1a6;
    font-size: 16.5px;
    line-height: 1.6;
    text-wrap: pretty;
  }

  @media (max-width: 900px) {
    .shot-copy {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 14px;
      margin-bottom: 22px;
    }

    .shot-title {
      font-size: 30px;
    }
  }

  @media (max-width: 640px) {
    .shots {
      --shots-width: calc(100% - 24px);
      padding-top: 88px;
    }

    .shot + .shot {
      margin-top: 72px;
    }

    .shot-copy {
      padding-inline: 4px;
    }

    .shot-copy::before {
      inset: -40px -20px;
    }

    .shot-title {
      font-size: 26px;
    }

    .shot-text {
      font-size: 15.5px;
    }
  }
</style>
