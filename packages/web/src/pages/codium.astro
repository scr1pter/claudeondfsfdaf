---
import { publicCodiumTiers } from "../../../../api/_lib/codium-public"
import { CodiumPricing } from "../components/marketing/codium/CodiumPricing"
import "../components/marketing/codium/codium-pricing.css"
import MarketingLayout from "../components/marketing/MarketingLayout.astro"
import LanderMaterials from "../components/marketing/LanderMaterials.astro"
import MarketingNav from "../components/marketing/MarketingNav.astro"
import SiteFooter from "../components/marketing/SiteFooter.astro"
import { codiumPricing } from "../lib/codium-pricing"
import { readModelPlanConfig } from "../lib/model-plans"

export const prerender = true

// Builds never capture runtime perks or founding status; the island reads the current configuration on mount.
const pricing = codiumPricing(readModelPlanConfig(await publicCodiumTiers(fetch, { runtime: false })))
const prices = pricing.monthly.map((plan) => plan.price)
---

<MarketingLayout
  title="Pricing · Vector Codium"
  description={`Vector is free. Codium is Vector's monthly plan, from $${Math.min(...prices)} to $${Math.max(...prices)}: coding models without provider keys, with more usage on Max and Ultra. No top-ups or overage charges.`}
>
  <div class="cx-page">
    {/* The landing page's top bar and footer retain the same materials. */}
    <div class="vector-marketing cx-bar">
      <MarketingNav active="codium" />
    </div>

    <main class="cx-main">
      <CodiumPricing client:load pricing={pricing} />

      <section class="cx-section cx-cta">
        <div class="cx-container">
          <div class="cx-cta-inner">
            <h2 class="cx-type-2xl">Get started with Vector.</h2>
            <div class="cx-cta-actions">
              <a class="cx-btn" href="/download">
                Download
                <span class="cx-btn-icon" aria-hidden="true">
                  <svg viewBox="0 0 12.5 16" fill="none" stroke="currentColor" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6.25 1.75v9.5M2.4 7.5l3.85 3.85L10.1 7.5M1.5 14.25h9.5"></path>
                  </svg>
                </span>
              </a>
              <a class="cx-btn cx-btn--secondary" href="/docs">Read the docs</a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <SiteFooter />
  </div>
  <LanderMaterials />
</MarketingLayout>
