#pragma code_page(65001)
#include <windows.h>

1 RT_MANIFEST "@VECTOR_COMPUTER_MANIFEST@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @HELPER_VERSION_NUMERIC@
 PRODUCTVERSION @HELPER_VERSION_NUMERIC@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "@HELPER_DISPLAY_NAME@\0"
      VALUE "FileVersion", "@HELPER_VERSION@\0"
      VALUE "InternalName", "vector-computer\0"
      VALUE "OriginalFilename", "@HELPER_EXECUTABLE@\0"
      VALUE "ProductName", "Vector\0"
      VALUE "ProductVersion", "@HELPER_VERSION@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
