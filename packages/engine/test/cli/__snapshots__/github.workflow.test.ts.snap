      "name": "Vector agent",
      "needs": "route",
      "outputs": {
        "status": "ok",
      },
      "permissions": {
        "actions": "read",
        "contents": "read",
        "issues": "read",
        "pull-requests": "read",
      },
      "runs-on": "ubuntu-latest",
      "steps": [
