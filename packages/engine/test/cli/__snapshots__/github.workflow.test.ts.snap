exports[`workflow v3 scheduled App publishing golden, header, and explicit permissions 1`] = `
{
  "jobs": {
    "agent": {
      "concurrency": {
        "cancel-in-progress": false,
        "group": "\${{ github.event_name == 'schedule' && format('vector-schedule-{0}', needs.route.outputs.thread) || format('vector-{0}-{1}', needs.route.outputs.thread, github.event.comment.id || github.run_id) }}",
      },
      "env": {
        "VECTOR_WORKFLOW_VERSION": "3",
      },
      "if": "needs.route.outputs.kind == 'task'",
      "name": "Vector agent",
      "needs": "route",
      "outputs": {
        "status": "ok",
      },
      "permissions": {
        "actions": "read",
        "contents": "read",
        "issues": "read",
        "pull-requests": "read",
      },
      "runs-on": "ubuntu-latest",
      "steps": [
        {
          "uses": "actions/setup-node@v4",
          "with": {
            "node-version": 20,
          },
        },
        {
          "uses": "actions/cache/restore@v4",
          "with": {
            "key": "vector-cli-1.99.113-\${{ runner.os }}",
            "path": "~/.npm",
          },
        },
        {
          "name": "Install Vector",
          "run": "npm install -g @vectordevai/cli@1.99.113 --prefer-offline --no-audit --no-fund",
        },
        {
          "uses": "actions/checkout@v4",
          "with": {
            "fetch-depth": 0,
            "persist-credentials": false,
            "ref": "\${{ needs.route.outputs.ref }}",
          },
        },
        {
          "env": {
            "VECTOR_AGENT_SUDO": "\${{ vars.VECTOR_AGENT_SUDO }}",
            "VECTOR_MODE": "own-key",
            "VECTOR_WORKFLOW_VERSION": "3",
          },
          "id": "sandbox",
          "if": "runner.environment == 'github-hosted'",
          "run": "vector github sandbox prepare",
        },
        {
          "env": {
            "GITHUB_TOKEN": "\${{ secrets.GITHUB_TOKEN }}",
            "MENTIONS": "@vector-dev,/vector,/vs,/vectorscope,/vx",
            "MODEL": "openai/gpt-4.1",
            "OPENAI_API_KEY": "\${{ secrets.OPENAI_API_KEY }}",
            "SHARE": "false",
            "VECTOR_CLI_TOKEN": "\${{ secrets.VECTOR_CLI_TOKEN }}",
            "VECTOR_DISABLE_USAGE": "1",
            "VECTOR_MODE": "own-key",
            "VECTOR_PROMPT": "\${{ inputs.prompt }}",
            "VECTOR_PURE": "1",
            "VECTOR_SCHEDULE_PROMPTS": "{"17 9 * * 1-5":{"id":"daily","prompt":"Fix \\"bugs\\": \\u0024{{ secrets.GITHUB_TOKEN }}\\n\\u0024HOME\\nquote' and \\\\u0024"}}",
            "VECTOR_SECRET_ENV_NAMES": "OPENAI_API_KEY",
            "VECTOR_THREAD": "\${{ needs.route.outputs.thread }}",
            "VECTOR_WORKFLOW_VERSION": "3",
          },
          "id": "agent",
          "run": "vector github sandbox run -- vector github run --phase agent",
          "shell": "env -u ACTIONS_ID_TOKEN_REQUEST_URL -u ACTIONS_ID_TOKEN_REQUEST_TOKEN bash --noprofile --norc -eo pipefail {0}",
        },
        {
          "env": {
            "VECTOR_MODE": "own-key",
            "VECTOR_WORKFLOW_VERSION": "3",
          },
          "id": "sandbox_finish",
          "if": "always()",
          "run": "vector github sandbox finish",
        },
        {
          "if": "always() && steps.agent.outcome != 'skipped' && steps.sandbox_finish.outcome == 'success'",
          "uses": "actions/upload-artifact@v4",
          "with": {
            "name": "vector-run-\${{ github.run_id }}-\${{ github.run_attempt }}",
            "path": "\${{ runner.temp }}/vector-out/",
            "retention-days": 1,
          },
        },
      ],
      "timeout-minutes": 60,
    },
    "bind": {
      "env": {
        "VECTOR_WORKFLOW_VERSION": "3",
      },
      "if": "needs.route.outputs.kind == 'bind'",
      "name": "Vector bind",
      "needs": "route",
      "permissions": {
        "id-token": "write",
      },
      "runs-on": "ubuntu-latest",
      "steps": [
        {
          "uses": "actions/setup-node@v4",
          "with": {
            "node-version": 20,
          },
        },
        {
          "name": "Install Vector",
          "run": "npm install -g @vectordevai/cli@1.99.113 --prefer-offline --no-audit --no-fund",
        },
        {
          "env": {
            "VECTOR_BIND_CODE": "\${{ inputs.code }}",
            "VECTOR_WORKFLOW_VERSION": "3",
          },
          "run": "vector github bind",
        },
      ],
      "timeout-minutes": 5,
    },
    "publish": {
      "env": {
        "VECTOR_WORKFLOW_VERSION": "3",
      },
      "if": "always() && needs.route.outputs.kind == 'task'",
      "name": "Vector publish",
      "needs": [
        "route",
        "agent",
      ],
      "permissions": {
        "contents": "write",
        "id-token": "write",
        "issues": "write",
        "pull-requests": "write",
      },
      "runs-on": "ubuntu-latest",
      "steps": [
        {
          "uses": "actions/setup-node@v4",
          "with": {
            "node-version": 20,
          },
        },
        {
          "name": "Install Vector",
          "run": "npm install -g @vectordevai/cli@1.99.113 --prefer-offline --no-audit --no-fund",
        },
        {
          "uses": "actions/checkout@v4",
          "with": {
            "fetch-depth": 0,
            "persist-credentials": false,
            "ref": "\${{ needs.route.outputs.ref }}",
          },
        },
        {
          "continue-on-error": true,
          "uses": "actions/download-artifact@v4",
          "with": {
            "name": "vector-run-\${{ github.run_id }}-\${{ github.run_attempt }}",
            "path": "\${{ runner.temp }}/vector-bundle",
          },
        },
        {
          "env": {
            "GITHUB_TOKEN": "\${{ secrets.GITHUB_TOKEN }}",
            "MENTIONS": "@vector-dev,/vector,/vs,/vectorscope,/vx",
            "VECTOR_AGENT_STATUS": "ok",
            "VECTOR_BUNDLE_DIR": "\${{ runner.temp }}/vector-bundle",
            "VECTOR_DISABLE_PROJECT_CONFIG": "1",
            "VECTOR_DISABLE_USAGE": "1",
            "VECTOR_GITHUB_AUTH": "app",
            "VECTOR_MODE": "own-key",
            "VECTOR_PURE": "1",
            "VECTOR_REPO_DIR": "\${{ github.workspace }}",
            "VECTOR_ROUTE_KIND": "\${{ needs.route.outputs.kind }}",
            "VECTOR_ROUTE_PR": "\${{ needs.route.outputs.pr }}",
            "VECTOR_ROUTE_REF": "\${{ needs.route.outputs.ref }}",
            "VECTOR_RUN_ID": "",
            "VECTOR_SCHEDULE_PROMPTS": "{"17 9 * * 1-5":{"id":"daily","prompt":"Fix \\"bugs\\": \\u0024{{ secrets.GITHUB_TOKEN }}\\n\\u0024HOME\\nquote' and \\\\u0024"}}",
            "VECTOR_THREAD": "\${{ needs.route.outputs.thread }}",
            "VECTOR_WORKFLOW_VERSION": "3",
          },
          "run": "vector github publish",
          "working-directory": "\${{ runner.temp }}",
        },
      ],
      "timeout-minutes": 15,
    },
    "review": {
      "concurrency": {
        "cancel-in-progress": false,
        "group": "vector-review-\${{ github.event.pull_request.number || needs.route.outputs.pr }}",
      },
      "env": {
        "VECTOR_WORKFLOW_VERSION": "3",
      },
      "if": 
"!cancelled() && (
  needs.route.outputs.kind == 'review' || needs.route.outputs.kind == 'review-full')"
,
      "name": "Vector review",
      "needs": "route",
      "permissions": {
        "contents": "read",
        "pull-requests": "write",
      },
      "runs-on": "ubuntu-latest",
      "steps": [
        {
          "uses": "actions/checkout@v4",
          "with": {
            "fetch-depth": 1,
            "persist-credentials": false,
            "ref": "\${{ needs.route.outputs.ref || github.event.pull_request.head.sha }}",
          },
        },
        {
          "uses": "actions/setup-node@v4",
          "with": {
            "node-version": 20,
          },
        },
        {
          "uses": "actions/cache@v4",
          "with": {
            "key": "vector-cli-1.99.113-\${{ runner.os }}",
            "path": "~/.npm",
          },
        },
        {
