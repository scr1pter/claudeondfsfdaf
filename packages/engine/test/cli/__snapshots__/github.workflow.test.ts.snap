        },
        {
          "uses": "actions/checkout@v4",
          "with": {
            "fetch-depth": 0,
            "persist-credentials": false,
            "ref": "\${{ needs.route.outputs.ref }}",
          },
        },
        {
          "continue-on-error": true,
          "uses": "actions/download-artifact@v4",
          "with": {
            "name": "vector-run-\${{ github.run_id }}-\${{ github.run_attempt }}",
            "path": "\${{ runner.temp }}/vector-bundle",
          },
        },
        {
          "env": {
            "GITHUB_TOKEN": "\${{ secrets.GITHUB_TOKEN }}",
            "MENTIONS": "/vector,/vs,/vectorscope,/vx",
            "VECTOR_AGENT_STATUS": "ok",
            "VECTOR_BUNDLE_DIR": "\${{ runner.temp }}/vector-bundle",
            "VECTOR_DISABLE_PROJECT_CONFIG": "1",
            "VECTOR_DISABLE_USAGE": "1",
            "VECTOR_GITHUB_AUTH": "github",
            "VECTOR_MODE": "own-key",
            "VECTOR_PURE": "1",
            "VECTOR_REPO_DIR": "\${{ github.workspace }}",
            "VECTOR_REVIEW_AUTO": "1",
            "VECTOR_ROUTE_KIND": "\${{ needs.route.outputs.kind }}",
            "VECTOR_ROUTE_PR": "\${{ needs.route.outputs.pr }}",
            "VECTOR_ROUTE_REF": "\${{ needs.route.outputs.ref }}",
            "VECTOR_RUN_ID": "",
            "VECTOR_SCHEDULE_PROMPTS": "{}",
            "VECTOR_THREAD": "\${{ needs.route.outputs.thread }}",
            "VECTOR_WORKFLOW_VERSION": "3",
          },
          "run": "vector github publish",
          "working-directory": "\${{ runner.temp }}",
        },
      ],
      "timeout-minutes": 15,
    },
    "review": {
      "concurrency": {
        "cancel-in-progress": false,
        "group": "vector-review-\${{ github.event.pull_request.number || needs.route.outputs.pr }}",
      },
      "env": {
        "VECTOR_WORKFLOW_VERSION": "3",
      },
      "if": 
"!cancelled() && (
  (github.event_name == 'pull_request' &&
    github.event.pull_request.head.repo.full_name == github.repository &&
    github.event.pull_request.draft == false &&
    !contains(github.event.pull_request.labels.*.name, 'vector:skip') &&
    !contains(github.event.pull_request.labels.*.name, 'vector:paused') &&
    github.event.pull_request.user.login != 'dependabot[bot]' &&
    github.event.pull_request.user.login != 'renovate[bot]') ||
  needs.route.outputs.kind == 'review' || needs.route.outputs.kind == 'review-full')"
,
      "name": "Vector review",
      "needs": "route",
      "permissions": {
        "contents": "read",
        "pull-requests": "write",
      },
      "runs-on": "ubuntu-latest",
      "steps": [
        {
          "uses": "actions/checkout@v4",
          "with": {
            "fetch-depth": 1,
            "persist-credentials": false,
            "ref": "\${{ needs.route.outputs.ref || github.event.pull_request.head.sha }}",
          },
        },
        {
          "uses": "actions/setup-node@v4",
          "with": {
            "node-version": 20,
          },
        },
        {
          "uses": "actions/cache@v4",
          "with": {
            "key": "vector-cli-1.99.113-\${{ runner.os }}",
            "path": "~/.npm",
          },
        },
        {
