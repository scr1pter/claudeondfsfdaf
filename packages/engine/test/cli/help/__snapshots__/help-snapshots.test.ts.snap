// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`vector CLI help-text snapshots every documented command emits stable help text: vector acp --help 1`] = `
"vector acp

start ACP (Agent Client Protocol) server

Options:
  -h, --help             show help                                                         [boolean]
  -v, --version          show version number                                               [boolean]
      --print-logs       print logs to stderr                                              [boolean]
      --log-level        log level              [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure             run without external plugins                                      [boolean]
      --port             port to listen on                                     [number] [default: 0]
      --hostname         hostname to listen on                       [string] [default: "127.0.0.1"]
      --mdns             enable mDNS service discovery (defaults hostname to 0.0.0.0)
                                                                          [boolean] [default: false]
      --unsecured        explicitly allow a network listener without a password
                                                                          [boolean] [default: false]
      --trusted-network  accept the server password over plain HTTP on a non-loopback address, on a
                         network you trust such as a container bridge or a private LAN
                                                                          [boolean] [default: false]
      --mdns-domain      custom domain name for mDNS service (default: vector.local)
                                                                  [string] [default: "vector.local"]
      --cors             additional domains to allow for CORS                  [array] [default: []]
      --cwd              working directory [string] [default: "<HOME>"]"
`;

exports[`vector CLI help-text snapshots every documented command emits stable help text: vector mcp --help 1`] = `
"vector mcp

manage MCP (Model Context Protocol) servers

Commands:
  vector mcp add [name]     add an MCP server
  vector mcp list           list MCP servers and their status                          [aliases: ls]
  vector mcp auth [name]    authenticate with an OAuth-enabled MCP server
  vector mcp logout [name]  remove OAuth credentials for an MCP server
  vector mcp debug <name>   debug OAuth connection for an MCP server

Options:
  -h, --help        show help                                                              [boolean]
  -v, --version     show version number                                                    [boolean]
      --print-logs  print logs to stderr                                                   [boolean]
      --log-level   log level                   [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure        run without external plugins                                           [boolean]"
`;

exports[`vector CLI help-text snapshots every documented command emits stable help text: vector attach --help 1`] = `
"vector attach <url>

attach to a running vector server

Positionals:
  url  http://localhost:4096                                                     [string] [required]

Options:
  -h, --help          show help                                                            [boolean]
  -v, --version       show version number                                                  [boolean]
      --print-logs    print logs to stderr                                                 [boolean]
      --log-level     log level                 [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure          run without external plugins                                         [boolean]
      --dir           directory to run in                                                   [string]
  -c, --continue      continue the last session                                            [boolean]
  -s, --session       session id to continue                                                [string]
      --fork          fork the session when continuing (use with --continue or --session)  [boolean]
  -p, --password      basic auth password (defaults to VECTOR_SERVER_PASSWORD)              [string]
  -u, --username      basic auth username (default: VECTOR_SERVER_USERNAME or vector)       [string]
      --mini          start the minimal interactive interface             [boolean] [default: false]
      --no-replay     disable mini session history replay on resume and after resize       [boolean]
      --replay-limit  cap visible mini replay to the newest N messages                      [number]"
`;

exports[`vector CLI help-text snapshots every documented command emits stable help text: vector run --help 1`] = `
"vector run [message..]

run vector with a message

Positionals:
  message  message to send                                                     [array] [default: []]

Options:
  -h, --help         show help                                                             [boolean]
  -v, --version      show version number                                                   [boolean]
      --print-logs   print logs to stderr                                                  [boolean]
      --log-level    log level                  [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure         run without external plugins                                          [boolean]
      --command      the command to run, use message for args                               [string]
      --workflow     run a saved workflow name or local JSON file; prints its plan and progress to
                     stderr and report to stdout                                            [string]
      --input        with --workflow: input key=value (JSON values or literal strings)       [array]
      --summarize    with --workflow: ask the conversation's agent to summarize the final report
                                                                                           [boolean]
  -c, --continue     continue the last session                                             [boolean]
  -s, --session      session id to continue                                                 [string]
      --fork         fork the session before continuing (requires --continue or --session) [boolean]
      --share        publish this session’s conversation, code, and tool output publicly on
                     vectordev.ai, including future updates (30 days)                      [boolean]
  -m, --model        model to use in the format of provider/model                           [string]
      --agent        agent to use                                                           [string]
      --format       format: default (formatted) or json (raw JSON events)
                                          [string] [choices: "default", "json"] [default: "default"]
  -f, --file         file(s) to attach to message                                            [array]
      --title        title for the session (defaults to the truncated prompt)               [string]
      --attach       attach to a running vector server (e.g., http://localhost:4096)        [string]
  -p, --password     basic auth password (defaults to VECTOR_SERVER_PASSWORD)               [string]
  -u, --username     basic auth username (default: VECTOR_SERVER_USERNAME or vector)        [string]
      --dir          directory to run in, path on remote server if attaching                [string]
      --port         port for the local server (defaults to random port if no value provided)
                                                                                            [number]
      --variant      model variant (provider-specific reasoning effort, e.g., high, max, minimal)
                                                                                            [string]
      --thinking     show thinking blocks                                                  [boolean]
  -i, --interactive  run in direct interactive split-footer mode          [boolean] [default: false]
      --max-cost     Dollar cap for this run. Vector Codium steps are not counted; step limits still
                     apply.                                                                 [number]
      --max-steps    stop this run after this many model steps                              [number]
      --size         how much harness each prompt gets: auto (default) sizes it from what it says;
                     standard and thorough may hand work to subagents
                                 [string] [choices: "auto", "chat", "light", "standard", "thorough"]
      --judge        run LLM-as-a-judge after large tasks that changed files (thorough) or after
                     every task that changed files (changes)
                                                    [string] [choices: "off", "thorough", "changes"]
      --research     Deep research (preview): plan the question, search and read the web and this
                     repository's brain, and write a report in which each claim cites a quote from
                     its source. Makes no code changes. Reads public pages for the run without
                     asking; any other approval, a page on your own network included, needs --auto
                                                                                           [boolean]
      --depth        with --research: focused (one agent, plus up to 2 researchers), deep (up to 4
                     researchers and a judge that checks the citations) or auto (the default)
                                                       [string] [choices: "focused", "deep", "auto"]
      --search       with --research: browser (the default: each research agent searches the web in
                     its own browser in the desktop app) or none (this repository's brain, its files
                     and the addresses in the message)         [string] [choices: "browser", "none"]
      --scope        with --research: the web, this repository's brain and files, or both (all)
                                                           [string] [choices: "web", "brain", "all"]
      --report       with --research: write the report, with its sources, to this Markdown file
                                                                                            [string]
      --auto         auto-approve permissions that are not explicitly denied (dangerous!)
                                                                          [boolean] [default: false]
      --local        keep this run on Vector Local: model calls go only to the model servers on your
                     list, and Vector's own requests to vectordev.ai are blocked. It only tightens,
                     and changes no setting                                                [boolean]"
`;

exports[`vector CLI help-text snapshots every documented command emits stable help text: vector debug --help 1`] = `
"vector debug

debugging and troubleshooting tools

