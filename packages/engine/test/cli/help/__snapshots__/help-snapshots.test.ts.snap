exports[`vector CLI help-text snapshots every documented command emits stable help text: vector workflow --help 1`] = `
"vector workflow <action> [target]

validate workflows or manage runs (separate from memory workflow insights)

Positionals:
  action        [string] [required] [choices: "saved", "validate", "list", "show", "resume", "stop"]
  target  workflow name/file for validate; run ID for show, resume or stop                  [string]

Options:
  -h, --help          show help                                                            [boolean]
  -v, --version       show version number                                                  [boolean]
      --print-logs    print logs to stderr                                                 [boolean]
      --log-level     log level                 [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure          run without external plugins                                         [boolean]
      --attach        owning server URL; omit for offline file validation                   [string]
  -s, --session       parent session ID for list, show, resume or stop                      [string]
      --dir           workspace directory on the attached server                            [string]
      --file          replacement workflow JSON file for resume                             [string]
      --input         input key=value; JSON values are parsed, other values stay strings     [array]
      --retry-failed  retry failed nodes when resuming                     [boolean] [default: true]
      --reason        why this run should stop                                              [string]
      --json          print the structured response                       [boolean] [default: false]
      --username      server username (or VECTOR_SERVER_USERNAME)                           [string]
      --password      server password (prefer VECTOR_SERVER_PASSWORD)                       [string]"
`;
