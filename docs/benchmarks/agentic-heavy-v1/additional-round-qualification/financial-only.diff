+def financial_headroom(state, actor, funding_profile=None):
+    policy = funding_policy(funding_profile)
+    global_left = policy.study_cap_usd - state["measuredUsd"] - state["reservedUsd"] - policy.historical_liability_usd
+    actor_left = policy.actor_cap(actor) - state["actors"][actor]["measuredUsd"] - state["actors"][actor]["reservedUsd"]
+    if policy.phase == ADDITIONAL_PHASE:
+        global_left = min(global_left, policy.new_round_usd - state["newRoundMeasuredUsd"] - state["newRoundReservedUsd"])
+        actor_left -= ADDITIONAL_LIABILITIES[actor]
+    return global_left, actor_left
