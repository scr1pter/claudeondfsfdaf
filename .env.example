# Vector accounts (server-only)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Signs vct_ CLI tokens (unless VECTOR_CLI_TOKEN_SECRET is set) and keys rate limits.
# Keep the existing value: changing it signs every terminal out.
VECTOR_LICENSE_SECRET=

# Bug-report email (Resend). Reports go to VECTOR_BUG_REPORT_TO; without it they answer 503.
RESEND_API_KEY=
VECTOR_PURCHASE_EMAIL_FROM=Vector <support@your-domain.example>
VECTOR_BUG_REPORT_TO=reports@your-domain.example

# Public production URLs
VECTOR_PUBLIC_URL=https://vectordev.ai
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Hosted OAuth broker for Vector Desktop Cloud Services
VECTOR_OAUTH_PUBLIC_URL=https://vectordev.ai
VECTOR_OAUTH_STATE_SECRET=
VECTOR_VERCEL_INTEGRATION_SLUG=
VECTOR_VERCEL_CLIENT_ID=
VECTOR_VERCEL_CLIENT_SECRET=
VECTOR_SUPABASE_CLIENT_ID=
VECTOR_SUPABASE_CLIENT_SECRET=

# Vector Help AI assistant. Server-side only — the desktop bundle never ships it.
# Groq retires hosted models without notice; if help starts returning
# HELP_UPSTREAM_404, pick a current id from https://api.groq.com/openai/v1/models
GROQ_API_KEY=
GROQ_HELP_MODEL=openai/gpt-oss-120b

# Persistent Codium billing storage (server-only). Use a separate Preview/test store.
# UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN are supported alternatives.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Authorizes every scheduled billing job in vercel.json. Keep it server-only.
CRON_SECRET=

# Vector Codium monthly plans (server-only; payment connection deferred). There are no top-ups.
# Leave false until the owner completes the protected test-mode and launch checks.
# After launch, use the private owner's sales/codium switches to pause sales/service;
# setting this false also stops Codium for existing subscribers.
MODEL_PLANS_ENABLED=false
# live or test, matching STRIPE_SECRET_KEY. A live key runs only with VERCEL_ENV=production.
# Every Codium store key sits under vector:codium:<mode>:, so test and live records never mix.
CODIUM_STRIPE_MODE=
# Runtime: a restricted rk_ key with the required billing permissions. The local setup
# script needs a separate sk_ setup key; never deploy that setup key as the runtime key.
STRIPE_SECRET_KEY=
STRIPE_MODEL_PLAN_WEBHOOK_SECRET=
# The single no-change portal: cancellations and payment-method updates only.
# Plan upgrades/downgrades are handled by Vector, never by a change-enabled portal.
STRIPE_MODEL_PLAN_PORTAL_CONFIG_ID=
# Enable only after the owner has configured Stripe Tax; monthly prices use exclusive tax.
CODIUM_STRIPE_AUTOMATIC_TAX=false
# Management key from the separate Codium OpenRouter account, never a browser/client key.
OPENROUTER_MANAGEMENT_KEY=
# Exactly 64 hex characters. Keep the existing value once encrypted keys exist.
MODEL_PLAN_KEY_ENCRYPTION_SECRET=
STRIPE_MODEL_PLAN_10_PRICE_ID=
STRIPE_MODEL_PLAN_50_PRICE_ID=
STRIPE_MODEL_PLAN_100_PRICE_ID=
STRIPE_MODEL_PLAN_200_PRICE_ID=
# The founding lock ("your price won't go up while you stay subscribed"): when a plan's price rises, list its old
# price ids with their old amounts in cents (price_id:cents,...). Subscriptions on them keep paying that amount.
STRIPE_MODEL_PLAN_LEGACY_PRICES_10=
STRIPE_MODEL_PLAN_LEGACY_PRICES_50=
STRIPE_MODEL_PLAN_LEGACY_PRICES_100=
STRIPE_MODEL_PLAN_LEGACY_PRICES_200=
# Founding members: the window is the earlier of this many paid founders or this many days after the first paid
# month (0–100000 founders, 0–3650 days). List `founding` in CODIUM_LISTED_PERKS to offer it; it leaves every page
# when the window closes. MODEL_PLANS_SALES_OPENED_AT (ISO date or ms) overrides when sales opened. An invalid value
# closes the founding window only (the owner page names it); Codium keeps running.
CODIUM_FOUNDING_LIMIT=500
CODIUM_FOUNDING_DAYS=90
MODEL_PLANS_SALES_OPENED_AT=
# Configure private credit allowances or a private markup in the hosting environment before enabling sales.
# There is no default allowance or markup; missing private configuration leaves purchases unavailable.
# Codium stays off unless Pro, Max and Ultra credits are 5.5x, 12x and 25x Plus's (within 0.05), the public
# usage multiples; a markup alone scales by price and cannot meet them.
MODEL_CREDIT_MARKUP_PERCENT=
MODEL_PLAN_10_CREDITS_USD=
MODEL_PLAN_50_CREDITS_USD=
MODEL_PLAN_100_CREDITS_USD=
MODEL_PLAN_200_CREDITS_USD=
# Blank uses the reviewed coding catalog; [] intentionally disables all models.
MODEL_PLAN_MODELS_JSON=
# Oldest desktop or CLI version Codium serves, like 1.99.113. Blank uses the compiled-in minimum.
MODEL_PLANS_MIN_CLIENT=
# Only tokens marked for Codium spend it (default true); set false only to debug.
MODEL_PLAN_REQUIRE_MARKED_TOKENS=
# Stripe test mode only: each OpenRouter key Codium creates is capped at this many dollars
# (default 0.50, at most 200). These test keys still spend real OpenRouter funds.
# Test checkout and /owner/codium use this comma-separated Google account allowlist.
# Set it explicitly; a blank owner allowlist retains the existing Design Lab owner fallback.
# Configure Google sign-in in the existing Supabase project; the dashboard uses the
# normal /account OAuth return and requires a fresh Google sign-in for mutations.
CODIUM_TEST_CREDIT_CAP_USD=
VECTOR_ADMIN_EMAILS=
# Server-only risk settings: request 3DS at/above this price unless prior paid history exempts it.
# Trust ramp accepts 0–30 days; renewal grace accepts 0–360 minutes.
CODIUM_3DS_MIN_USD=100
CODIUM_TRUST_RAMP_DAYS=7
CODIUM_RENEWAL_GRACE_MINUTES=120
# Early-fraud warnings refund/cancel by default. false freezes access without refunding.
CODIUM_EFW_REFUND=true
# Optional Stripe Radar card-fingerprint block list.
CODIUM_RADAR_BLOCKLIST_ID=
# Minutes continuously switched off before Vector voids collection (1–1440, default 60).
CODIUM_CODIUM_OFF_PAUSE_MINUTES=60

# Codium funding check, owner alerts and private ledger.
# Pause and reopen emails go here (falls back to VECTOR_BUG_REPORT_TO); they use RESEND_API_KEY above.
CODIUM_OWNER_EMAIL=
# At least 32 characters; authorizes GET /api/model-plans/ledger only.
# /owner/codium instead uses the allowlisted Google session, never this secret in a browser.
CODIUM_OWNER_SECRET=
# New sales need OpenRouter's balance to cover what customers hold or are buying, plus this margin (defaults 10 and 20).
CODIUM_FUNDING_MARGIN_PERCENT=
CODIUM_FUNDING_MARGIN_USD=
# Match the Codium account's dashboard auto top-up threshold. Blank disables the 20-minute
# watchdog; Vector observes dashboard auto top-up and never purchases credits itself.
CODIUM_OPENROUTER_TOPUP_THRESHOLD_USD=
# Positive USD/hour threshold; blank disables the funding spend-spike alert.
CODIUM_SPEND_SPIKE_USD_PER_HOUR=
# OpenRouter credit-purchase fee estimate (default 5.5%, unverified; confirm your account's terms).
CODIUM_OPENROUTER_FEE_PERCENT=

# Signed Vercel Spend Management callbacks at POST /api/owner/spend-vercel.
# Team IDs must be distinct. Use each team's own callback signing secret.
# Main only alerts; hosted escalates no-new at 75% and stop at 100%, never reopens itself.
VERCEL_MAIN_TEAM_ID=
VERCEL_SPEND_WEBHOOK_SECRET_MAIN=
VERCEL_HOSTED_TEAM_ID=
VERCEL_SPEND_WEBHOOK_SECRET_HOSTED=

# Local private planning only: bun scripts/codium-economics.ts from packages/web.
# No allowance defaults or provider calls. Output includes private allowances; do not publish it.
# Provider override falls back to CODIUM_OPENROUTER_FEE_PERCENT, then the unverified 5.5% estimate.
# Payment assumptions default to 2.9% + $0.30 and 0.7% subscription billing; confirm your actual fees.
CODIUM_PROVIDER_FEE_PERCENT=
CODIUM_PAYMENT_FEE_PERCENT=
CODIUM_PAYMENT_FIXED_USD=
CODIUM_SUBSCRIPTION_FEE_PERCENT=

# Shared service plumbing (WP A37). Values never go in the repository; generate them where they are set.
# Phone alerts (Web Push). A P-256 key pair, base64url: the 65-byte public point and the 32-byte private scalar, e.g.
#   node -e "const e=require('crypto').createECDH('prime256v1');e.generateKeys();console.log(e.getPublicKey('base64url'),e.getPrivateKey('base64url'))"
# The subject is a mailto: or https: contact the browsers' push services can reach. Push also needs the push switch on.
VECTOR_VAPID_PUBLIC_KEY=
VECTOR_VAPID_PRIVATE_KEY=
VECTOR_VAPID_SUBJECT=
# The phone app's https origin; push subscriptions are accepted from it as well as from the site. The phone app (WP A38)
# is served at https://remote.vectordev.ai/phone/ (vercel.json), so set https://remote.vectordev.ai once that domain is
# on the project. Phone alerts are listable only with this and the VAPID keys set.
VECTOR_PHONE_APP_ORIGIN=
# Signed internal calls (at least 32 characters each): the relay and hosted computers share the first, each under its own
# derived key; the ops Worker uses the second.
VECTOR_HOSTED_INTERNAL_SECRET=
VECTOR_OPS_SHARED_SECRET=
# Cloudflare R2 for presigned URLs (900 seconds at most). Use tokens scoped to one bucket each.
# Buckets default to vector-vault and vector-media.
VECTOR_R2_ACCOUNT_ID=
VECTOR_R2_VAULT_ACCESS_KEY_ID=
VECTOR_R2_VAULT_SECRET_ACCESS_KEY=
VECTOR_R2_VAULT_BUCKET=
VECTOR_R2_MEDIA_ACCESS_KEY_ID=
VECTOR_R2_MEDIA_SECRET_ACCESS_KEY=
VECTOR_R2_MEDIA_BUCKET=
# Brain Vault on Vector (WP A44). Apply docs/vector/owner-actions/sql/brain-vault.sql first and read
# docs/vector/owner-actions/brain-vault.md. The store also uses SUPABASE_SERVICE_ROLE_KEY, the vault bucket above, and
# RESEND_API_KEY with VECTOR_PURCHASE_EMAIL_FROM for the read-only notice. true makes Vault listable once the owner adds
# vault to CODIUM_LISTED_PERKS (after the legal read); the vault switch can still turn uploads off without a redeploy.
VECTOR_VAULT_ENABLED=false
# At least 32 random characters, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))".
# Names every account in the vault store and bucket. Set it once and never change it: a new value is a new, empty vault
# for everyone, and the old vaults can no longer be found to delete.
VECTOR_VAULT_ACCOUNT_SALT=
# Vector Remote's API (WP A40), which mints the relay's tickets. Set up the relay first (docs/vector/owner-actions/remote.md).
# true turns ticket minting on; the owner's remote switch can still turn it off without a redeploy.
VECTOR_REMOTE_ENABLED=false
# The Ed25519 private key tickets are signed with, base64url PKCS#8 (the relay holds the public half in TICKET_PUBLIC_KEYS).
VECTOR_REMOTE_TICKET_SIGNING_KEY=
# The relay Worker's wss:// origin, with no path. Its signed internal calls use VECTOR_HOSTED_INTERNAL_SECRET above.
VECTOR_REMOTE_RELAY_URL=
# Production checks (WP A47): On Call and Release Guard on the ops Worker (docs/vector/owner-actions/hosted-ops.md).
# true says the ops services are set up; the owner's ops switch can still turn them off without a redeploy. Its signed
# calls use VECTOR_OPS_SHARED_SECRET above.
VECTOR_OPS_ENABLED=false
# The ops Worker's https origin, with no path, e.g. https://vector-ops.<your-subdomain>.workers.dev.
VECTOR_OPS_WORKER_URL=
# On Call, Release Guard and Ship Desk do new work only once each is in CODIUM_LISTED_PERKS. Before that, the account
# ids listed here (comma separated, your own to try them) may use them; they still need a plan with them.
VECTOR_OPS_ALLOW_ACCOUNTS=
# The GitHub App's webhook secret (at least 32 characters), for POST /api/github/webhook. Set the same value on the App.
VECTOR_GITHUB_APP_WEBHOOK_SECRET=
# The ops guard (WP A50, every 10 minutes) reads the ops Worker's month from Cloudflare's GraphQL Analytics API: an API
# token with Account Analytics: Read and nothing else, and the OpsAccount Durable Object namespace id. The account id
# falls back to VECTOR_R2_ACCOUNT_ID; the script defaults to vector-ops. Without them the guard never holds an account.
VECTOR_OPS_CF_ACCOUNT_ID=
VECTOR_OPS_CF_ANALYTICS_TOKEN=
VECTOR_OPS_CF_NAMESPACE_ID=
VECTOR_OPS_CF_SCRIPT=
# Optional: the guard's estimate of one subscriber's monthly ops cost at the caps, in dollars (defaults 0.11 and 0.90).
# The budget is (Max subscribers x the first + Ultra subscribers x the second) x 2 + 5.
VECTOR_OPS_GUARD_CAP_COST_100_USD=
VECTOR_OPS_GUARD_CAP_COST_200_USD=
# The cloud computer's ledger (WP A51). Apply docs/vector/owner-actions/sql/hosted.sql first and read
# docs/vector/owner-actions/hosted-computer.md. The ledger also uses SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY; no
# block of computer time opens without it. At least 32 random characters, e.g.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))". Names every account in the hosted
# ledger and its computers. Set it once and never change it.
VECTOR_HOSTED_ACCOUNT_SALT=
# Optional: what one GB of egress from a cloud computer costs Vector, in whole micro-dollars, once Vercel confirms it.
# Unset, egress is charged at $0.15 a GB plus 10%. An invalid value stops new cloud computer work.
VECTOR_HOSTED_EGRESS_MICRO_USD_PER_GB=
# Cloud computers start only once computer is in CODIUM_LISTED_PERKS. Before that, the account ids listed here (comma
# separated, your own to try it) may start one; they still need a plan with a cloud computer.
VECTOR_HOSTED_ALLOW_ACCOUNTS=
# The cloud computer's provider (WP A52). Leave VECTOR_HOSTED_PROVIDER blank until Vercel's written OK: blank, nothing
# can start or reach a computer. "vercel" needs every setting below, on the vector-hosted team that
# VERCEL_HOSTED_TEAM_ID and VERCEL_SPEND_WEBHOOK_SECRET_HOSTED guard, never the main team. The token is an access token
# scoped to that team, the Vercel project is the team's one empty project, and the snapshot id comes from the image
# workflow. Read docs/vector/owner-actions/hosted-computer.md first.
VECTOR_HOSTED_PROVIDER=
VECTOR_HOSTED_VERCEL_TOKEN=
VECTOR_HOSTED_VERCEL_TEAM_ID=
VECTOR_HOSTED_VERCEL_PROJECT_ID=
VECTOR_HOSTED_BASE_SNAPSHOT=
# Outside production only: another run-API host, for a preview testing in Stripe test mode. Production always uses
# hosted-run.vectordev.ai, which the computers' browser is barred from.
VECTOR_HOSTED_RUN_HOST=
